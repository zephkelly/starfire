/* Behavior Tree Editor Stylesheet */

/* Grid background */
GridBackground {
    --grid-background-color: #1a1a1a;
    --line-color: #2a2a2a;
    --thick-line-color: #3a3a3a;
    --spacing: 25;
}

/* Node base styles */
.node {
    min-width: 150px;
    margin: 0;
    padding: 0;
}

.node #title {
    -unity-font-style: bold;
    font-size: 12px;
}

/* Composite nodes (Selector, Sequence) - Blue */
.composite-node {
    background-color: rgba(40, 60, 100, 0.9);
}

.composite-node #title {
    background-color: rgba(50, 80, 140, 1);
}

/* Decorator nodes (Repeater, Condition) - Yellow/Orange */
.decorator-node {
    background-color: rgba(100, 90, 40, 0.9);
}

.decorator-node #title {
    background-color: rgba(140, 120, 50, 1);
}

/* Action nodes - Green */
.action-node {
    background-color: rgba(40, 80, 40, 0.9);
}

.action-node #title {
    background-color: rgba(50, 110, 50, 1);
}

/* Root node indicator */
.root-node {
    border-width: 3px;
    border-color: #ffcc00;
}

.root-node #title {
    background-color: rgba(200, 160, 0, 1);
}

/* Node description text */
.node-description {
    font-size: 10px;
    color: rgba(200, 200, 200, 0.8);
    -unity-text-align: middle-center;
    margin-top: 4px;
    margin-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
}

/* Ports */
.port {
    align-items: center;
}

#input {
    flex-direction: column;
    padding-top: 4px;
}

#output {
    flex-direction: column-reverse;
    padding-bottom: 4px;
}

/* Edge styles */
.edge {
    --edge-width: 2;
}

.edge:hover {
    --edge-width: 4;
}

.edge.selected {
    --edge-color: #44ff88;
}

/* Selection */
.node:selected {
    border-color: #44aaff;
    border-width: 2px;
}

/* Inspector panel */
#inspector-panel {
    background-color: rgba(40, 40, 40, 0.95);
    padding: 10px;
}

#inspector-header {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    color: #ffffff;
}
