// Fluid Simulation Compute Shader
// Implements Stable Fluids (Jos Stam) Navier-Stokes solver

#pragma kernel AddForces
#pragma kernel Advect
#pragma kernel Diffuse
#pragma kernel ComputeDivergence
#pragma kernel PressureJacobi
#pragma kernel ProjectVelocity
#pragma kernel ApplyBoundaries
#pragma kernel AdvectDensity
#pragma kernel DecayDensity
#pragma kernel InjectDensitySource
#pragma kernel ClearTexture
#pragma kernel InitializeDensity

// Thread group size
#define THREAD_GROUP_SIZE 8

// Textures (ping-pong buffers)
RWTexture2D<float2> _VelocityWrite;
Texture2D<float2> _VelocityRead;

RWTexture2D<float> _PressureWrite;
Texture2D<float> _PressureRead;

RWTexture2D<float> _Divergence;

RWTexture2D<float> _DensityWrite;
Texture2D<float> _DensityRead;

// Background density source (for gas cloud visualization)
Texture2D<float> _DensitySource;

// Samplers - Unity auto-binds sampler_<TextureName>
SamplerState sampler_VelocityRead;
SamplerState sampler_PressureRead;
SamplerState sampler_DensityRead;
SamplerState sampler_DensitySource;

// Uniforms
float2 _Resolution;
float _DeltaTime;
float _Viscosity;
float _DensityDecay;
float _VelocityDamping;
float _DensitySourceStrength;

// Simulation bounds in world space
float2 _SimulationCenter;
float2 _SimulationSize;

// Obstacle data structure
struct ObstacleData
{
    float2 position;
    float2 velocity;
    float2 halfExtents;
    float rotation;
    float velocityScale;
};

StructuredBuffer<ObstacleData> _Obstacles;
int _ObstacleCount;

// Manual density injection
float2 _InjectionPosition;
float _InjectionRadius;
float _InjectionAmount;

// Ship push strength for radial displacement
float _ShipPushStrength;
float _InfluenceRadiusMultiplier;

// Clear value for ClearTexture kernel
float _ClearValue;
int _ClearMode; // 0 = float, 1 = float2

// Initial density for InitializeDensity kernel
float _InitialDensity;

// Noise parameters for natural cloud appearance
float _NoiseScale;
float _NoiseContrast;
float2 _NoiseSeed;

// ============================================================================
// Utility Functions
// ============================================================================

// Simple hash function for noise
float hash(float2 p)
{
    p = frac(p * float2(443.897, 441.423));
    p += dot(p, p.yx + 19.19);
    return frac((p.x + p.y) * p.x);
}

// Value noise with smooth interpolation
float valueNoise(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);

    // Smooth interpolation
    float2 u = f * f * (3.0 - 2.0 * f);

    // Sample corners
    float a = hash(i);
    float b = hash(i + float2(1.0, 0.0));
    float c = hash(i + float2(0.0, 1.0));
    float d = hash(i + float2(1.0, 1.0));

    // Bilinear interpolation
    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

// Fractal Brownian Motion noise - multiple octaves for natural appearance
float fbmNoise(float2 p, int octaves)
{
    float value = 0.0;
    float amplitude = 0.5;
    float frequency = 1.0;

    for (int i = 0; i < octaves; i++)
    {
        value += amplitude * valueNoise(p * frequency);
        amplitude *= 0.5;
        frequency *= 2.0;
    }

    return value;
}

// Convert cell index to UV coordinates (0-1)
float2 CellToUV(uint2 cell)
{
    return (cell + 0.5) / _Resolution;
}

// Convert UV to world position
float2 UVToWorld(float2 uv)
{
    return _SimulationCenter + (uv - 0.5) * _SimulationSize;
}

// Convert world position to UV
float2 WorldToUV(float2 worldPos)
{
    return (worldPos - _SimulationCenter) / _SimulationSize + 0.5;
}

// Convert cell index to world position
float2 CellToWorld(uint2 cell)
{
    return UVToWorld(CellToUV(cell));
}

// Check if UV is within bounds
bool IsInBounds(float2 uv)
{
    return all(uv >= 0.0) && all(uv <= 1.0);
}

// Bilinear sample velocity with boundary handling
float2 SampleVelocity(float2 uv)
{
    uv = clamp(uv, 0.001, 0.999);
    return _VelocityRead.SampleLevel(sampler_VelocityRead, uv, 0);
}

// Bilinear sample pressure with boundary handling
float SamplePressure(float2 uv)
{
    uv = clamp(uv, 0.001, 0.999);
    return _PressureRead.SampleLevel(sampler_PressureRead, uv, 0);
}

// Bilinear sample density with boundary handling
float SampleDensity(float2 uv)
{
    uv = clamp(uv, 0.001, 0.999);
    return _DensityRead.SampleLevel(sampler_DensityRead, uv, 0);
}

// Rotate a 2D point
float2 RotatePoint(float2 p, float angle)
{
    float c = cos(angle);
    float s = sin(angle);
    return float2(
        p.x * c - p.y * s,
        p.x * s + p.y * c
    );
}

// Check if a point is inside an ellipse obstacle
bool IsInsideEllipse(float2 worldPos, ObstacleData obs)
{
    // Transform to obstacle's local space
    float2 localPos = RotatePoint(worldPos - obs.position, -obs.rotation);
    float2 normalized = localPos / obs.halfExtents;
    return dot(normalized, normalized) < 1.0;
}

// Compute signed distance to ellipse (approximate)
float EllipseDistance(float2 worldPos, ObstacleData obs)
{
    float2 localPos = RotatePoint(worldPos - obs.position, -obs.rotation);
    float2 normalized = localPos / obs.halfExtents;
    float distSq = dot(normalized, normalized);

    // Approximate signed distance
    float dist = sqrt(distSq) - 1.0;
    float scale = min(obs.halfExtents.x, obs.halfExtents.y);
    return dist * scale;
}

// ============================================================================
// Kernel: AddForces
// Apply radial push and wake forces from obstacles to create visible displacement
// Gas is pushed outward from moving ships, creating realistic fluid parting effect
// ============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void AddForces(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Resolution)) return;

    float2 worldPos = CellToWorld(id.xy);
    float2 currentVel = _VelocityRead[id.xy];
    float2 force = float2(0, 0);

    for (int i = 0; i < _ObstacleCount; i++)
    {
        ObstacleData obs = _Obstacles[i];
        float speed = length(obs.velocity);

        // Skip stationary obstacles for push effect
        if (speed < 0.01) continue;

        float dist = EllipseDistance(worldPos, obs);

        // Influence zone - configurable multiplier of the ship's largest dimension
        float baseRadius = max(obs.halfExtents.x, obs.halfExtents.y);
        float influenceRadius = baseRadius * _InfluenceRadiusMultiplier;

        // Only affect cells within influence zone
        if (dist > influenceRadius) continue;

        // Smooth falloff from ship edge
        float influence = 1.0 - saturate(dist / influenceRadius);
        influence = influence * influence * influence;  // Cubic falloff for tighter effect

        // Direction from ship center to this cell (for radial push)
        float2 toCell = worldPos - obs.position;
        float toCellLen = length(toCell);
        float2 pushDir = toCellLen > 0.001 ? toCell / toCellLen : float2(0, 1);

        // Radial push - gas is pushed outward from ship
        float pushMagnitude = speed * obs.velocityScale * _ShipPushStrength * influence;
        force += pushDir * pushMagnitude;

        // Wake effect - also add ship's velocity direction for trailing wake
        force += obs.velocity * obs.velocityScale * influence * 0.3;
    }

    // Apply velocity damping
    currentVel *= (1.0 - _VelocityDamping * _DeltaTime);

    _VelocityWrite[id.xy] = currentVel + force * _DeltaTime;
}

// ============================================================================
// Kernel: Advect
// Semi-Lagrangian advection of velocity field
// ============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void Advect(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Resolution)) return;

    float2 uv = CellToUV(id.xy);
    float2 velocity = _VelocityRead[id.xy];

    // Backtrace position
    float2 prevUV = uv - velocity * _DeltaTime / _SimulationSize;

    // Sample velocity at previous position
    _VelocityWrite[id.xy] = SampleVelocity(prevUV);
}

// ============================================================================
// Kernel: Diffuse
// Jacobi iteration for velocity diffusion (viscosity)
// ============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void Diffuse(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Resolution)) return;

    float2 dx = float2(1.0 / _Resolution.x, 0);
    float2 dy = float2(0, 1.0 / _Resolution.y);
    float2 uv = CellToUV(id.xy);

    float2 center = _VelocityRead[id.xy];
    float2 left = SampleVelocity(uv - dx);
    float2 right = SampleVelocity(uv + dx);
    float2 down = SampleVelocity(uv - dy);
    float2 up = SampleVelocity(uv + dy);

    float alpha = (_Resolution.x * _Resolution.x) / (_Viscosity * _DeltaTime);
    float beta = 4.0 + alpha;

    _VelocityWrite[id.xy] = (left + right + down + up + alpha * center) / beta;
}

// ============================================================================
// Kernel: ComputeDivergence
// Compute divergence of velocity field
// ============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void ComputeDivergence(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Resolution)) return;

    float2 dx = float2(1.0 / _Resolution.x, 0);
    float2 dy = float2(0, 1.0 / _Resolution.y);
    float2 uv = CellToUV(id.xy);

    float2 left = SampleVelocity(uv - dx);
    float2 right = SampleVelocity(uv + dx);
    float2 down = SampleVelocity(uv - dy);
    float2 up = SampleVelocity(uv + dy);

    float divergence = ((right.x - left.x) + (up.y - down.y)) * 0.5;

    _Divergence[id.xy] = divergence;
}

// ============================================================================
// Kernel: PressureJacobi
// Single Jacobi iteration for pressure solve
// ============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void PressureJacobi(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Resolution)) return;

    float2 dx = float2(1.0 / _Resolution.x, 0);
    float2 dy = float2(0, 1.0 / _Resolution.y);
    float2 uv = CellToUV(id.xy);

    float left = SamplePressure(uv - dx);
    float right = SamplePressure(uv + dx);
    float down = SamplePressure(uv - dy);
    float up = SamplePressure(uv + dy);

    float divergence = _Divergence[id.xy];

    float pressure = (left + right + down + up - divergence) * 0.25;

    _PressureWrite[id.xy] = pressure;
}

// ============================================================================
// Kernel: ProjectVelocity
// Subtract pressure gradient from velocity to make it divergence-free
// ============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void ProjectVelocity(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Resolution)) return;

    float2 dx = float2(1.0 / _Resolution.x, 0);
    float2 dy = float2(0, 1.0 / _Resolution.y);
    float2 uv = CellToUV(id.xy);

    float left = SamplePressure(uv - dx);
    float right = SamplePressure(uv + dx);
    float down = SamplePressure(uv - dy);
    float up = SamplePressure(uv + dy);

    float2 gradient = float2(right - left, up - down) * 0.5;

    float2 velocity = _VelocityRead[id.xy];
    _VelocityWrite[id.xy] = velocity - gradient;
}

// ============================================================================
// Kernel: ApplyBoundaries
// Enforce boundary conditions at obstacles and domain edges
// Obstacles are treated as solid boundaries (no flow inside)
// ============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void ApplyBoundaries(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Resolution)) return;

    float2 worldPos = CellToWorld(id.xy);
    float2 vel = _VelocityWrite[id.xy];

    // Obstacle boundaries - treat as solid (velocity = 0 inside)
    // This creates pressure differential that pushes fluid around the obstacle
    for (int i = 0; i < _ObstacleCount; i++)
    {
        ObstacleData obs = _Obstacles[i];

        if (IsInsideEllipse(worldPos, obs))
        {
            vel = float2(0, 0);  // Solid boundary - no flow inside
        }
    }

    // Domain boundaries - zero normal velocity component
    if (id.x == 0) vel.x = max(vel.x, 0);
    if (id.x == (uint)_Resolution.x - 1) vel.x = min(vel.x, 0);
    if (id.y == 0) vel.y = max(vel.y, 0);
    if (id.y == (uint)_Resolution.y - 1) vel.y = min(vel.y, 0);

    _VelocityWrite[id.xy] = vel;
}

// ============================================================================
// Kernel: AdvectDensity
// Advect density field through velocity field
// ============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void AdvectDensity(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Resolution)) return;

    float2 uv = CellToUV(id.xy);
    float2 velocity = SampleVelocity(uv);

    // Backtrace position
    float2 prevUV = uv - velocity * _DeltaTime / _SimulationSize;

    // Sample density at previous position
    _DensityWrite[id.xy] = SampleDensity(prevUV);
}

// ============================================================================
// Kernel: DecayDensity
// Fade density over time for "local displacement" feel
// ============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void DecayDensity(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Resolution)) return;

    float density = _DensityRead[id.xy];

    // Exponential decay
    density *= exp(-_DensityDecay * _DeltaTime);

    _DensityWrite[id.xy] = density;
}

// ============================================================================
// Kernel: InjectDensitySource
// Inject background density from source texture (optional ambient gas replenishment)
// Note: Obstacles affect VELOCITY only. Density is carried by advection.
// ============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void InjectDensitySource(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Resolution)) return;

    float2 uv = CellToUV(id.xy);

    float currentDensity = _DensityRead[id.xy];

    // Background source for maintaining ambient gas (optional - can be disabled via strength=0)
    float sourceDensity = _DensitySource.SampleLevel(sampler_DensitySource, uv, 0);
    currentDensity += sourceDensity * _DensitySourceStrength * _DeltaTime;

    // Manual injection point (for user input / debugging only)
    if (_InjectionRadius > 0)
    {
        float2 injectionUV = WorldToUV(_InjectionPosition);
        float dist = length(uv - injectionUV) * _Resolution.x / _SimulationSize.x;
        float injection = saturate(1.0 - dist / _InjectionRadius) * _InjectionAmount;
        currentDensity += injection * _DeltaTime;
    }

    currentDensity = saturate(currentDensity);
    _DensityWrite[id.xy] = currentDensity;
}

// ============================================================================
// Kernel: ClearTexture
// Clear a texture to a specified value
// ============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void ClearTexture(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Resolution)) return;

    if (_ClearMode == 0)
    {
        _DensityWrite[id.xy] = _ClearValue;
    }
    else
    {
        _VelocityWrite[id.xy] = float2(_ClearValue, _ClearValue);
    }
}

// ============================================================================
// Kernel: InitializeDensity
// Initialize density field with uniform value
// Visual noise is handled in the visualization shader for infinite detail
// ============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void InitializeDensity(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Resolution)) return;

    // Uniform density - visual noise is handled in the visualization shader
    // This allows the simulation to run at low resolution while maintaining visual quality
    _DensityWrite[id.xy] = saturate(_InitialDensity);
}

